# 0.0.0.0 permite que as estações de leitura acessem o computador Principal pela LAN.
API_HOST=0.0.0.0
API_PORT=3000
# Pasta dos logs texto de comandos CLP. No aplicativo desktop, o padrao e Documentos/PCM-IHM/logs.
# PLC_COMMAND_LOG_DIR=C:\PCM-IHM\logs
# Chave compartilhada do IFTS CSV Bridge. Se ficar vazia, o endpoint aceita requisicoes sem X-API-Key.
IFTS_CSV_BRIDGE_API_KEY=123
# Endereço e credencial usados pela IHM para controlar o Bridge no PC do IFTS.
IFTS_BRIDGE_BASE_URL=http://192.168.137.1:8787
IFTS_BRIDGE_API_KEY=123
IFTS_BRIDGE_TIMEOUT_MS=60000
# Tempo máximo para o Bridge abrir o IFTS e aplicar o Auto Save Set.
IFTS_BRIDGE_STARTUP_TIMEOUT_MS=60000
# Máquina da linha que representa a estação de teste de memória. Sem esta variável, o fluxo IFTS opera apenas em debug.
IFTS_MEMORY_MACHINE_ID=m2
# Quantidade exata de posições exigida no resultado produtivo do IFTS.
IFTS_EXPECTED_POSITION_COUNT=20
# Opções do simulador de linha (M2 é a estação IFTS por padrão).
SIM_IFTS_STATION=2
SIM_IFTS_RESULT_SOURCE=simulated
SIM_IFTS_START_COIL=23
SIM_IFTS_RESULT_COIL=24
SIM_IFTS_BRIDGE_URL=http://127.0.0.1:8787
SIM_IFTS_BRIDGE_API_KEY=123
# SIM_IFTS_LOG_ROOT=C:\caminho\para\Log
# Senha local para cadastrar/alterar a área deste computador. Ela não é gravada no station.json.
SETUP_PASSWORD=123
# Senha do perfil ADMIN usada para gerenciar operadores e turnos.
ADMIN_PASSWORD=troque-esta-senha
# Quantidade de dias que os registros operacionais permanecem no MongoDB (1 a 3650).
OPERATIONAL_LOG_RETENTION_DAYS=365
# Limites do aviso de temperatura do computador Principal (°C).
PC_TEMPERATURE_WARNING_C=80
PC_TEMPERATURE_CRITICAL_C=90
# LibreHardwareMonitor: habilite Options > Remote Web Server > Run em cada PC.
LIBRE_HARDWARE_MONITOR_URL=http://127.0.0.1:8085/data.json
# Prazo sem heartbeat para considerar a estação de Final de Linha desconectada.
END_OF_LINE_HEARTBEAT_TIMEOUT_MS=15000
# Somente bancada: permite bipagem mesmo com a inspeção/Final de Linha offline.
ALLOW_OFFLINE_INSPECTION=false
# Linha usada pela bipagem. Cadastre-a em POST /api/lines antes de iniciar a produção.
PCM_LINE_ID=PCM
# Nome exibido para a estação operacional deste computador Principal.
PCM_STATION_NAME=Principal
PCM_STATION_ID=linha-01
# Bandeja e prefixo dos 20 chips criados pelo botão REINICIAR ESTAÇÃO para ensaios controlados.
PCM_TEST_RESET_TRAY_SERIAL=BANDEJA-TESTE-01
PCM_TEST_RESET_CHIP_PREFIX=CHIP-TESTE
# MongoDB: preencher para habilitar o registro de entrada da linha.
# Valores abaixo já servem para o container Docker (docker-compose.yml).
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=pcm
MONGO_USER=pcm_app
MONGO_PASSWORD=pcm_app
# Usadas apenas pelo container MongoDB (usuário root), não pela aplicação.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root
# IPs, portas, Unit IDs, polling e mapa Modbus de cada máquina são configurados
# na tela Cadastro de máquinas e persistidos no MongoDB, não neste arquivo.
